# One or more public KiwiSDRs, tried in order and rotated on disconnect.
# Pick receivers from the public KiwiSDR list/map; favor ones with a free slot,
# no time limit, and good 11 MHz reception toward the HFGCS stations. Use receivers
# with their own host:port; *.proxy.kiwisdr.com hosts drop kiwirecorder after login.
KIWI_HOSTS=
KIWI_USER=skywatch
# KIWI_PASSWORD=

FREQ_KHZ=11175
MODE=usb
PASSBAND_LO=300
PASSBAND_HI=2700

# Squelch, relative to the tracked noise floor
SQUELCH_OPEN_DB=8
SQUELCH_CLOSE_DB=5
SQUELCH_HANG_S=3.0
MIN_TX_S=4

# whisper | none
ASR_BACKEND=whisper
# tiny.en / base.en / small.en / medium.en ; small.en is a good CPU tradeoff
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
MIN_WORD_PROB=0.45
# Whisper's own voice detection; 1 drops most HF voice as noise, so leave it off
WHISPER_VAD=0

# Archive radio checks / phone patches too (1) or only EAMs + Skykings (0)
KEEP_NON_EAM=1
LOG_LEVEL=INFO

# Crowd corrections: votes needed (with no tie) before the crowd's character
# replaces the machine copy, and the per-voter limit per hour
CORRECTION_MIN_VOTES=2
CORRECTION_RATE=120
# Set to 1 only behind a reverse proxy you control, so voters are keyed on X-Forwarded-For
TRUST_PROXY=0

# Strategic aircraft from public ADS-B (any ADSBExchange-v2-style feed)
ADSB_ENABLED=1
ADSB_URL=https://api.adsb.lol/v2/mil
ADSB_POLL_S=30

# Notifications. Browser push stays off until PUSH_SUBJECT is set: it's how push
# services (Google, Mozilla, Apple) contact whoever runs this server.
# PUSH_SUBJECT=mailto:you@example.com
PUSH_KINDS=eam
# Optional: also post each new message to an ntfy topic (subscribe in the ntfy app)
# NTFY_URL=https://ntfy.sh/your-unguessable-topic
# Optional: email when an E-4B Nightwatch is first heard on ADS-B
# ALERT_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# SMTP_FROM=
